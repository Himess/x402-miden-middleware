{
  "name": "x402-miden-middleware",
  "version": "0.1.0",
  "description": "Express and Hono middleware for x402 Miden payment walls — one-line paywall for any route",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "keywords": [
    "miden",
    "x402",
    "middleware",
    "express",
    "hono",
    "paywall",
    "payments",
    "http-402",
    "privacy",
    "zk"
  ],
  "author": "Himess",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Himess/x402-miden-middleware"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "hono": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^5.0.0",
    "hono": "^4.7.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
